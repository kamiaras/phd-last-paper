{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch LaTeX (fresh_rewrite)",
      "type": "process",
      "command": "${env:SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.cursor/hooks/watch-latex.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MIKTEX_DISABLEWELCOME": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    }
  ]
}
