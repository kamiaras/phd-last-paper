{
  "version": 1,
  "hooks": {
    "workspaceOpen": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/watch-latex.ps1 -Background",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/watch-latex.ps1 -Background",
        "timeout": 15
      }
    ]
  }
}
